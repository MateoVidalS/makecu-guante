GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
# Required by extended-thinking Live models (low | medium | high); ignored by gemini-3.8-live.
GEMINI_LIVE_THINKING_LEVEL=medium
GEMINI_LIVE_VOICE=Puck
GEMINI_TEXT_MODEL=gemini-4-argon
# Tried in order when the main model is busy (503) or too slow (504).
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
REHAB_DB_PATH=data/rehab.db
REHAB_PORT=8000
