GEMINI_API_KEY=
# gemini-3.8-live is the only current Live model that calls the coach's tools (see tools/coach_check.py).
GEMINI_LIVE_MODEL=gemini-3.8-live
# Only used by extended-thinking Live models (low | medium | high); ignored by gemini-3.8-live.
GEMINI_LIVE_THINKING_LEVEL=medium
GEMINI_LIVE_VOICE=Puck
GEMINI_TEXT_MODEL=gemini-4-argon
# Tried in order when the main model is busy (503) or too slow (504).
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Seconds one summary model may take before the next is tried (the last gets the rest of ~55 s).
GEMINI_TEXT_ATTEMPT_TIMEOUT_S=20
REHAB_DB_PATH=data/rehab.db
REHAB_PORT=8000
